end;

procedure TForm1.imgAcercaDeClick(Sender: TObject);
var
  Ventana: TFormAcercaDe;
begin
  Ventana := TFormAcercaDe.Create(Self);
  try
    Ventana.ShowModal;
  finally
    Ventana.Free;
  end;
end;

