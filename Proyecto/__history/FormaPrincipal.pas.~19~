procedure TForm1.ImgLoginClick(Sender: TObject);
var
  RutaEmu: string;
  RutaProyecto: string;
  Resultado: HINST;
begin
  RutaEmu := 'C:\emu8086\emu8086.exe';
  RutaProyecto := 'C:\Users\mg708\OneDrive\Documentos\Lenguajes de interfaz\Proyecto\emu\main.asm';

  if FileExists(RutaEmu) and FileExists(RutaProyecto) then
  begin
    // Abre Emu8086 con el archivo principal
    Resultado := ShellExecute(
      Handle,
      'open',
      PChar(RutaEmu),
      PChar('"' + RutaProyecto + '"'),
      'C:\emu8086',
      SW_SHOWNORMAL
    );

    if NativeInt(Resultado) <= 32 then
    begin
      ShowMessage('No se pudo iniciar Emu8086.');
      Exit;
    end;

    // Espera a que Emu8086 cargue el archivo
    Sleep(2000);

    // Presionar F5 para abrir el emulador
    keybd_event(VK_F5, 0, 0, 0);
    keybd_event(VK_F5, 0, KEYEVENTF_KEYUP, 0);

    // Esperar a que aparezca la ventana del emulador
    Sleep(2500);

    // Presionar F9 para ejecutar el programa
    keybd_event(VK_F9, 0, 0, 0);
    keybd_event(VK_F9, 0, KEYEVENTF_KEYUP, 0);
  end
  else
    ShowMessage('No se encontró Emu8086 o main.asm.');
end;



end.
