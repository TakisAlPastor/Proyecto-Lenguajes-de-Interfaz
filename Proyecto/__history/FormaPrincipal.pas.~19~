procedure TForm1.imgAlertasClick(Sender: TObject);
var
  RutaEmu: string;
  RutaProyecto: string;
  Resultado: HINST;
begin
  RutaEmu := 'C:\emu8086\emu8086.exe';

  RutaProyecto := 'C:\Users\mg708\OneDrive\Documentos\Lenguajes de interfaz\Proyecto\emu\main.asm';

  if FileExists(RutaEmu) and FileExists(RutaProyecto) then
  begin
    Resultado := ShellExecute(
      Handle,
      'open',
      PChar(RutaEmu),
      PChar('"' + RutaProyecto + '"'),
      'C:\emu8086',
      SW_SHOWNORMAL
    );

    if NativeInt(Resultado) <= 32 then
      ShowMessage('No se pudo abrir el proyecto ASM.');
  end
  else
    ShowMessage('No se encontró Emu8086 o el archivo main.asm.');
end;

